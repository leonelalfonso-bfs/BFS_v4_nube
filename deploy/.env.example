# Copiar a deploy/.env y completar. El .env NO va al repositorio (tiene claves).

# Clave del usuario "bfs" de PostgreSQL (larga y al azar: openssl rand -base64 30)
PG_PASSWORD=

# Primer superadmin: se crea la primera vez que arranca. Después se pueden borrar estas dos líneas.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Días de licencia que se le renuevan a cada portería en cada sincronización
DIAS_LICENCIA=15

# Puerto local donde escucha la API (Nginx le pasa los pedidos de pesaje.<dominio>)
PUERTO_API=8080

# Límites para no quitarle recursos a Leal Control
API_MEMORIA=512m
API_CPUS=1.0
PG_MEMORIA=768m
PG_CPUS=1.0

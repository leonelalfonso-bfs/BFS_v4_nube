<Window x:Class="Bfs.Licencias.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generador de licencias BFS 4.0" Width="880" Height="760" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="14">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Generador de licencias" FontSize="24" FontWeight="Bold" Foreground="#0C223C" />
      <TextBlock Text="Para el Sistema de Pesaje BFS 4.0 (Completa y Estándar). La licencia se ata a la PC del cliente." Foreground="#5B6D82" />
    </StackPanel>

    <!-- Historial: cada licencia emitida queda anotada en esta PC (al tocar una, se vuelve a ver el texto). -->
    <DockPanel DockPanel.Dock="Bottom" Height="210" Margin="0,16,0,0">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Etiqueta}" Text="Licencias emitidas" />
      <TextBlock DockPanel.Dock="Bottom" x:Name="ArchivoHistorial" Foreground="#5B6D82" FontSize="12" Margin="0,4,0,0" />
      <DataGrid x:Name="Historial" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                SelectionMode="Single" SelectionChanged="Historial_SelectionChanged" GridLinesVisibility="Horizontal"
                Background="White" RowHeaderWidth="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Emitida" Binding="{Binding Emitida, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" />
          <DataGridTextColumn Header="Máquina" Binding="{Binding Maquina}" Width="170" />
          <DataGridTextColumn Header="Vence" Binding="{Binding VenceTexto}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Datos de la licencia -->
      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource Etiqueta}" Text="Clave privada de BFS" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Elegir..." Margin="6,0,0,0" Click="ElegirClave_Click" />
          <TextBox x:Name="Clave" TextChanged="Clave_TextChanged" />
        </DockPanel>
        <TextBlock x:Name="EstadoClave" Margin="0,4,0,0" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource Etiqueta}" Text="Cliente (razón social)" />
        <TextBox x:Name="Cliente" />

        <TextBlock Style="{StaticResource Etiqueta}" Text="ID de máquina" />
        <TextBox x:Name="Maquina" CharacterCasing="Upper" FontFamily="Consolas" />
        <TextBlock Foreground="#5B6D82" FontSize="12" TextWrapping="Wrap"
                   Text="El cliente lo ve en Configuración → Licencia (o en Pesaje si no tiene licencia). Ej.: MAC-A82BDD69836D" />

        <TextBlock Style="{StaticResource Etiqueta}" Text="Vencimiento" />
        <CheckBox x:Name="SinVencimiento" Content="Sin vencimiento" IsChecked="True" Checked="Vencimiento_Changed" Unchecked="Vencimiento_Changed" />
        <DatePicker x:Name="Vence" Margin="0,6,0,0" IsEnabled="False" SelectedDateFormat="Long" />

        <Button x:Name="Generar" Content="Generar licencia" Margin="0,18,0,0" Padding="14,10" FontWeight="Bold"
                Background="#0F9D8E" Foreground="White" BorderBrush="#0B7C71" Click="Generar_Click" />
        <TextBlock x:Name="Error" Foreground="#C24141" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Resultado -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Etiqueta}" Text="Licencia (pegar en Configuración → Licencia)" />
        <TextBlock DockPanel.Dock="Top" x:Name="Resumen" Foreground="#15803D" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="Copiar" Content="Copiar" IsEnabled="False" Click="Copiar_Click" />
          <Button x:Name="Guardar" Content="Guardar license.key..." Margin="8,0,0,0" IsEnabled="False" Click="Guardar_Click" />
        </StackPanel>
        <TextBox x:Name="Texto" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" Background="White" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
